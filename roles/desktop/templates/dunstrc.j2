# BEGIN ANSIBLE MANAGED FILE: dunst/dunstrc
[global]
    monitor = 0
    follow = mouse
    width = 360
    height = 120
    origin = top-right
    offset = 10x10
    font = Monospace 10
    frame_width = 2
    timeout = 5

[urgency_low]
    timeout = 3

[urgency_normal]
    timeout = 5

[urgency_critical]
    timeout = 0
# END ANSIBLE MANAGED FILE: dunst/dunstrc
